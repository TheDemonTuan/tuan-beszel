{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beszel-heartbeat",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "routes": [
    {
      "pattern": "beszel-heartbeat.tuannguyenviet.site",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beszel-heartbeat",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
